[gd_scene load_steps=3 format=3 uid="uid://cprocedural_map_test"]

[ext_resource type="PackedScene" uid="uid://cprocedural_map_scene" path="res://scenes/world/procedural_map.tscn" id="1_procedural"]

[sub_resource type="GDScript" id="GDScript_test"]
script/source = "extends Node2D
## Test scene for procedural map generator.
## Press SPACE to regenerate with a random seed.
## Press R to regenerate with the same seed.
## Press number keys 1-9 to generate with specific seeds.
## Use arrow keys or WASD to pan the camera.

@onready var map: ProceduralMap = $ProceduralMap
@onready var camera: Camera2D = $ProceduralMap/Camera2D
@onready var seed_label: Label = $UI/SeedLabel

const PAN_SPEED := 300.0

func _ready() -> void:
	_update_seed_label()


func _process(delta: float) -> void:
	# Camera panning
	var pan_input := Vector2.ZERO
	if Input.is_action_pressed(\"ui_left\") or Input.is_key_pressed(KEY_A):
		pan_input.x -= 1
	if Input.is_action_pressed(\"ui_right\") or Input.is_key_pressed(KEY_D):
		pan_input.x += 1
	if Input.is_action_pressed(\"ui_up\") or Input.is_key_pressed(KEY_W):
		pan_input.y -= 1
	if Input.is_action_pressed(\"ui_down\") or Input.is_key_pressed(KEY_S):
		pan_input.y += 1

	if pan_input != Vector2.ZERO:
		camera.position += pan_input.normalized() * PAN_SPEED * delta


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_SPACE:
				# Random new seed
				map.regenerate_with_seed(0)
				_update_seed_label()
			KEY_R:
				# Same seed
				map.generate()
				_update_seed_label()
			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9:
				# Specific seed
				var seed_num: int = int(event.keycode) - int(KEY_0)
				map.regenerate_with_seed(seed_num * 12345)
				_update_seed_label()
			KEY_MINUS:
				# Zoom out
				var new_zoom_out := camera.zoom - Vector2(0.1, 0.1)
				camera.zoom = Vector2(maxf(new_zoom_out.x, 0.5), maxf(new_zoom_out.y, 0.5))
			KEY_EQUAL:
				# Zoom in
				var new_zoom_in := camera.zoom + Vector2(0.1, 0.1)
				camera.zoom = Vector2(minf(new_zoom_in.x, 4.0), minf(new_zoom_in.y, 4.0))
			KEY_C:
				# Center camera
				var bounds := map.get_map_bounds()
				camera.position = bounds.get_center()


func _update_seed_label() -> void:
	seed_label.text = \"Seed: %d\\nSPACE=new | R=regenerate | 1-9=preset seeds | +/-=zoom | WASD=pan\" % map.get_current_seed()
"

[node name="ProceduralMapTest" type="Node2D"]
script = SubResource("GDScript_test")

[node name="ProceduralMap" parent="." instance=ExtResource("1_procedural")]
map_width = 32
map_height = 24
map_seed = 42

[node name="Camera2D" parent="ProceduralMap" index="0"]
position = Vector2(512, 384)

[node name="UI" type="CanvasLayer" parent="."]

[node name="SeedLabel" type="Label" parent="UI"]
offset_left = 10.0
offset_top = 10.0
offset_right = 600.0
offset_bottom = 60.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 14
text = "Seed: 0
SPACE=new | R=regenerate | 1-9=preset seeds | +/-=zoom | WASD=pan"
